    <bpmn2:collaboration id="Collaboration_1" name="Default Collaboration">
        <bpmn2:documentation id="Documentation_1794899396474" textFormat="text/plain">Asynchronous aggregation receiver /trn/canvas/aggregate53. Lesson 057 sends ordered/reversed/incomplete groups and verifies the native aggregated XML through global datastore TRN053_LAB_RESULTS. Plain End prevents a synchronous reply after aggregation. Configure AggregationTimeoutMinutes; default one minute.</bpmn2:documentation>
        <bpmn2:extensionElements>
